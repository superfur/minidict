{
  "name": "minidict",
  "version": "3.0.1",
  "description": "一个简单易用的命令行词典 / 翻译工具（Bing、有道、Google）",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "dict": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bun run clean && tsc && chmod +x dist/cli.js",
    "dev": "tsc -w",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "bun run build",
    "prepare": "husky || true",
    "start": "node dist/cli.js",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test && bun run build"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "overrides": {
    "@babel/helpers": "^7.26.10",
    "ajv": "^6.14.0",
    "flatted": "^3.4.0",
    "js-yaml": "^3.14.2",
    "picomatch": "^2.3.2",
    "minimatch": "^3.1.3",
    "brace-expansion": "^1.1.12",
    "ip-address": "^10.2.0"
  },
  "keywords": [
    "dictionary",
    "cli",
    "translate",
    "translator",
    "bing",
    "youdao",
    "google",
    "词典",
    "翻译"
  ],
  "author": "Septem <septem@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "boxen": "^8.0.1",
    "chalk": "^4.1.2",
    "cheerio": "^1.2.0",
    "commander": "^12.1.0",
    "https-proxy-agent": "^7.0.6",
    "node-fetch": "^3.3.2",
    "socks-proxy-agent": "^8.0.5",
    "string-width": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/superfur/minidict.git"
  },
  "bugs": {
    "url": "https://github.com/superfur/minidict/issues"
  },
  "homepage": "https://github.com/superfur/minidict#readme"
}
